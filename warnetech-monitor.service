[Unit]
Description=Warnetech Core Docker Health Monitor
After=docker.service network.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/warnetech-core
ExecStart=/bin/bash /opt/warnetech-core/monitor_health.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
