# ---- provider keys (set the ones you use) --------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# NVIDIA NIM — powers `chat.nemotron` (the model Warnetech's firewall uses).
NVIDIA_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint

# ---- attribution ---------------------------------------------------------
WARNETECH_PROJECT=default
WARNETECH_TEAM=

# Run with the deterministic `echo` provider — no API keys needed.
WARNETECH_OFFLINE=0

# ---- prompts & models ----------------------------------------------------
WARNETECH_PROMPTS_DIR=./prompts
# WARNETECH_MODELS_FILE=./models.yaml

# ---- memory --------------------------------------------------------------
WARNETECH_MEMORY_BACKEND=sqlite          # sqlite | memory | pgvector | supabase
WARNETECH_MEMORY_PATH=./data/warnetech_memory.db
# WARNETECH_POSTGRES_DSN=postgresql://user:pass@localhost:5432/warnetech

# `supabase` backend — the canonical production store (one shared project).
# Project Settings -> Database. Pooled URI (:6543) for short-lived processes,
# direct (:5432) for long-running services.
# WARNETECH_SUPABASE_DSN=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
# Never issues DDL by default: apply migrations/0001_warnetech_memory.sql
# deliberately. Only set this if warnetech-core owns the database outright.
# WARNETECH_SUPABASE_MANAGE_SCHEMA=0
# WARNETECH_PGVECTOR_TABLE=warnetech_memory
WARNETECH_EMBED_MODEL=embed.default
WARNETECH_EMBED_DIMENSIONS=1536

# ---- cost tracking -------------------------------------------------------
WARNETECH_USAGE_BACKEND=sqlite           # sqlite | memory
WARNETECH_USAGE_PATH=./data/warnetech_usage.db
# Trailing-window spend caps, "name=usd" comma separated.
# WARNETECH_PROJECT_BUDGETS=hub-notes=5.00,hub-invoices=2.00
# WARNETECH_TEAM_BUDGETS=core=25.00
WARNETECH_BUDGET_WINDOW_SECONDS=86400

# ---- resilience ----------------------------------------------------------
WARNETECH_RETRY_MAX_ATTEMPTS=3
WARNETECH_ENABLE_FALLBACK=1
# WARNETECH_RATE_LIMIT_PER_SEC=5

# ---- AGI orchestrator ----------------------------------------------------
WARNETECH_AGI_MODEL=chat.default
WARNETECH_AGI_MAX_CYCLES=20
WARNETECH_AGI_MAX_RETRIES_PER_TASK=2

# ---- HTTP service only ---------------------------------------------------
# Required to start `warnetech_core.service.app` unless ALLOW_ANONYMOUS=1.
WARNETECH_API_TOKEN=
# WARNETECH_ALLOW_ANONYMOUS=0

# ---- Local models via Ollama (no key needed) ------------------------------
# Set OLLAMA_HOST to enable the `ollama` provider. Leave unset to disable it.
# OLLAMA_HOST=http://localhost:11434
# Local models (see config/local_models.yaml and docs/OLLAMA.md).
# WARNETECH_LOCAL_ONLY=1 refuses every hosted provider: no data leaves the machine.
# WARNETECH_LOCAL_MODELS=config/local_models.yaml routes the local.* aliases.
# OLLAMA_NODES=gpu=http://10.0.0.5:11434,laptop=http://10.0.0.9:11434 adds named machines.
# WARNETECH_LOCAL_ONLY=0
# WARNETECH_LOCAL_MODELS=
# OLLAMA_NODES=

# ---- Interpreter (natural-language computer control) ---------------------
# LM Studio's local server, an alternative to Ollama. Unset to disable.
# LMSTUDIO_HOST=http://localhost:1234
# The only directory the interpreter may read or write.
# WARNETECH_INTERPRETER_WORKSPACE=./workspace
# Append-only record of proposed and executed actions.
# WARNETECH_INTERPRETER_AUDIT=./data/interpreter_audit.jsonl

# ---- Vendored repositories ------------------------------------------------
# Override the repository root that vendor/ is looked up in (tests, unusual layouts).
# WARNETECH_REPO_ROOT=
