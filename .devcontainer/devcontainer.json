{
  "name": "warnetech-core",
  "image": "python:3.12-bookworm",
  "postCreateCommand": "pip install -e '.[dev,service]'",
  "containerEnv": {
    "WARNETECH_OFFLINE": "1"
  },
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": { "python.testing.pytestEnabled": true }
    }
  }
}
